{
	"name": "paullette-web",
	"version": "0.1.2",
	"description": "The web interface of paullette: a local web server that serves a conversation with the paullette agent in a browser",
	"type": "module",
	"license": "MIT",
	"exports": {
		"./*": {
			"development": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test:unit": "node --import tsx --conditions=development --test \"test/unit/**/*_test.ts\"",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@openai/agents": "^0.17.0",
		"marked": "^18.0.11",
		"paullette-core": "0.1.2"
	},
	"engines": {
		"node": ">=20.11.0"
	},
	"files": [
		"dist",
		"public",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeromeetienne/paullette.git",
		"directory": "packages/paullette-web"
	},
	"homepage": "https://github.com/jeromeetienne/paullette#readme",
	"bugs": {
		"url": "https://github.com/jeromeetienne/paullette/issues"
	},
	"keywords": [
		"ai",
		"coding-agent",
		"web",
		"openai",
		"llm",
		"agent"
	]
}
