{
	"name": "paullette",
	"version": "0.1.2",
	"description": "An AI coding agent command line interface, compatible with the .claude folder, running on any OpenAI API compatible endpoint",
	"type": "module",
	"license": "MIT",
	"bin": {
		"paullette": "./dist/cli.js"
	},
	"scripts": {
		"start": "tsx ./src/cli.ts",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"verify": "tsx ./test/run_verification.ts",
		"verify:fast": "tsx ./test/run_verification.ts --fast",
		"test:unit": "node --import tsx --test \"test/unit/**/*_test.ts\"",
		"test": "npm run test:unit && npm run verify",
		"publish:all": "npm run build && npm version patch && npm publish",
		"lmstudio:status": "lms server status",
		"lmstudio:start": "lms server start",
		"lmstudio:stop": "lms server stop",
		"clean": "rm -rf dist",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@openai/agents": "^0.17.0",
		"chalk": "^6.0.0",
		"commander": "^15.0.0",
		"openai": "^7.7.0",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=20.11.0"
	},
	"files": [
		"dist",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeromeetienne/paullette.git"
	},
	"homepage": "https://github.com/jeromeetienne/paullette#readme",
	"bugs": {
		"url": "https://github.com/jeromeetienne/paullette/issues"
	},
	"keywords": [
		"ai",
		"coding-agent",
		"cli",
		"openai",
		"llm",
		"claude-code",
		"agent"
	]
}
